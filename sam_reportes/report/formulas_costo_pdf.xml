<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="formulas_costo_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div style="text-align:left;color:black!important;">
                        <div class="row">
                            <div class="col">

                                <!-- ════════════════════════════════════════
                                     TABLA 1: FÓRMULAS (9 columnas)
                                ════════════════════════════════════════ -->
                                <table width="100%">
                                    <!-- Encabezado del reporte -->
                                    <tr>
                                        <t t-if="cant_limitante == 0">
                                            <th class="table-active" colspan="9" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:14px;vertical-align:middle; padding:2px">
                                              <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                <span style="float: left; max-width: 80%; overflow: hidden; text-overflow: ellipsis;">
                                                  <strong>Fórmula con costeo:</strong> <span t-esc="codigo"/> - <span t-esc="producto"/>
                                                </span>
                                                <span style="float: right; white-space: nowrap; margin-left: 10px;">
                                                  <strong>Tipo de cambio: </strong><span t-esc="'{0:,.4f}'.format(env.company.x_studio_tipo_de_cambio or 0.0)"/>
                                                </span>
                                              </div>
                                              <div>
                                                <span><strong>Cantidad: </strong> <span t-esc="'{0:,.4f}'.format(masa_formula)"/> Kgs.</span>
                                                <t t-if="pct_merma > 0">
                                                  <span>&#160;&#160;<strong>% Merma: </strong><span t-esc="'{0:,.2f}'.format(pct_merma)"/>%&#160;&#160;
                                                    <strong>Kg. después de merma: </strong><span t-esc="'{0:,.4f}'.format(cantidad_despues_merma)"/>
                                                  </span>
                                                </t>
                                                <t t-if="bom_code">
                                                  <span>&#160;&#160;<span t-esc="bom_code"/></span>
                                                </t>
                                                <span style="float: right; white-space: nowrap; margin-left: 10px;">
                                                  <t t-if="tipo_costo">(<t t-esc="tipo_costo"/>)</t>
                                                </span>
                                              </div>
                                            </th>
                                        </t>
                                        <t t-if="cant_limitante > 0">
                                            <th class="table-active" colspan="9" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:14px;vertical-align:middle; padding:2px">
                                              <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                <span style="float: left; max-width: 80%; overflow: hidden; text-overflow: ellipsis;">
                                                  <strong>Fórmula: </strong> <span t-esc="codigo"/> - <span t-esc="producto"/>
                                                </span>
                                                <span style="float: right; white-space: nowrap; margin-left: 10px;">
                                                  <strong>Tipo de cambio: </strong><span t-esc="'{0:,.4f}'.format(env.company.x_studio_tipo_de_cambio or 0.0)"/>
                                                </span>
                                              </div>
                                              <div>
                                                <strong>Ingrediente limitante: </strong> <span t-esc="nombre_il"/>
                                                <br/>
                                                <strong>Cantidad: </strong> <span t-esc="'{0:,.4f}'.format(cant_limitante)"/> Kgs.
                                              </div>
                                            </th>
                                        </t>
                                    </tr>

                                    <!-- Encabezados de columnas fórmula -->
                                    <tr>
                                        <td class="table-active" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:5px">
                                          <strong>Ingrediente</strong>
                                        </td>
                                        <td class="table-active" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:5px">
                                          <strong>Código</strong>
                                        </td>
                                        <td class="table-active" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:5px">
                                          <strong>Cantidad</strong>
                                        </td>
                                        <td width="18" class="table-active" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:5px">
                                          <strong>Unidad</strong>
                                        </td>
                                        <td width="15" class="table-active" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:5px">
                                          <strong>$ USD</strong>
                                        </td>
                                        <td width="15" class="table-active" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:5px">
                                          <strong>$ MN</strong>
                                        </td>
                                        <td width="15" class="table-active" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:5px">
                                          <strong>Importe MN</strong>
                                        </td>
                                        <td width="15" class="table-active" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:5px">
                                          <strong>Costo kg</strong>
                                        </td>
                                        <td width="15" class="table-active" style="border-style: solid;border-width: 1px;border-top: 1px solid #000000;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:5px">
                                          <strong>% Costo</strong>
                                        </td>
                                    </tr>

                                    <!-- ── Totales (calculados en el wizard: total_cost_formula, combined_total) ── -->

                                    <!-- Filas de fórmula -->
                                    <t t-set="tot_gral_formula" t-value="0"/>
                                    <t t-foreach="vals" t-as="table_line">
                                        <t t-set="line_import" t-value="table_line['costo'] * table_line['cant_comp']"/>
                                        <tr>
                                            <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px">
                                                <t t-esc="table_line['componente']"/>
                                            </td>
                                            <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px">
                                                <t t-esc="table_line['cod_prov']"/>
                                            </td>
                                            <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                <t t-esc="'{0:,.4f}'.format(table_line['cant_comp'])"/>
                                                <t t-set="tot_gral_formula" t-value="tot_gral_formula + table_line['cant_comp']"/>
                                            </td>
                                            <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px">
                                                <t t-esc="table_line['unidad']"/>
                                            </td>
                                            <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                <t t-esc="'{0:,.4f}'.format(table_line['costo_usd'])"/>
                                            </td>
                                            <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                <t t-esc="'{0:,.4f}'.format(table_line['costo'])"/>
                                            </td>
                                            <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                <t t-esc="'{0:,.2f}'.format(line_import)"/>
                                            </td>
                                            <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                <t t-esc="'{0:,.4f}'.format(line_import / masa_formula if masa_formula > 0 else 0)"/>
                                            </td>
                                            <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                <t t-esc="'{0:,.2f}'.format((line_import / combined_total) * 100 if combined_total > 0 else 0)"/>%
                                            </td>
                                        </tr>
                                    </t>

                                    <!-- Subtotal fórmulas -->
                                    <t t-set="costo_kg_formula" t-value="total_cost_formula / tot_gral_formula if tot_gral_formula > 0 else 0"/>
                                    <tr>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"><strong>Total masa</strong></td>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                            <strong t-esc="'{0:,.4f}'.format(tot_gral_formula)"/>
                                        </td>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"><strong>KG</strong></td>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                            <strong t-esc="'{0:,.2f}'.format(total_cost_formula)"/>
                                        </td>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                            <strong t-esc="'{0:,.4f}'.format(costo_kg_formula)"/>
                                        </td>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                            <t t-esc="'{0:,.2f}'.format((total_cost_formula / combined_total) * 100 if combined_total > 0 else 0)"/>%
                                        </td>
                                    </tr>
                                </table>

                                <!-- ════════════════════════════════════════
                                     TABLA 2: INTERMEDIOS (11 columnas)
                                     Ingrediente | Código | Kg/Unidad | Unidad/Pieza | Cantidad
                                     | Unidad | $USD | $MN | Importe MN | Costo kg/masa | % Costo

                                     Se recorre "bloques_modulo" (calculado en el wizard): un bloque
                                     por cada módulo implementado (1 = masa del producto, sin ítems
                                     propios; 2-4 = Intermedios/Empaques/Empaques de rebanados, mismo
                                     layout). Cada bloque imprime, en este orden, su sección de ítems
                                     (si tiene nombre e ítems) y luego su merma asociada (si el
                                     módulo tiene una ligada en mermas.py).
                                ════════════════════════════════════════ -->
                                <t t-if="bloques_modulo">
                                <table width="100%" style="margin-top: 4px;">

                                    <t t-foreach="bloques_modulo" t-as="bloque">

                                        <!-- ── Sección de ítems del módulo (si ya tiene layout implementado) ── -->
                                        <t t-if="bloque['nombre'] and bloque['items']">
                                            <!-- Título de sección -->
                                            <tr>
                                                <td colspan="11" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:12px;vertical-align:middle; padding:2px">
                                                    <strong t-esc="bloque['nombre']"/>
                                                </td>
                                            </tr>
                                            <!-- Sub-encabezado -->
                                            <tr>
                                                <td class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>Ingrediente</strong></td>
                                                <td class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>Código</strong></td>
                                                <td width="15" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>Kg/Unidad</strong></td>
                                                <td width="15" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>Unidad/Pieza</strong></td>
                                                <td width="15" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>Cantidad</strong></td>
                                                <td width="18" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>Unidad</strong></td>
                                                <td width="15" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>$ USD</strong></td>
                                                <td width="15" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>$ MN</strong></td>
                                                <td width="15" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>Importe MN</strong></td>
                                                <td width="15" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>Costo kg/masa</strong></td>
                                                <td width="15" class="table-active" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:5px"><strong>% Costo</strong></td>
                                            </tr>
                                            <!-- Filas de datos -->
                                            <t t-foreach="bloque['items']" t-as="item">
                                                <tr>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px">
                                                        <t t-esc="item['name']"/>
                                                    </td>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                        <t t-if="item['kgs_unidad'] > 0">
                                                            <t t-esc="'{0:,.4f}'.format(item['kgs_unidad'])"/>
                                                        </t>
                                                    </td>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                        <t t-if="item['unidad_pza'] > 0">
                                                            <t t-esc="'{0:,.4f}'.format(item['unidad_pza'])"/>
                                                        </t>
                                                    </td>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                        <t t-esc="'{0:,.4f}'.format(item['item_cant'])"/>
                                                    </td>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px">
                                                        <t t-esc="item['product_uom_name']"/>
                                                    </td>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                        <t t-esc="'{0:,.4f}'.format(item['item_costo_usd_unit'])"/>
                                                    </td>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                        <t t-esc="'{0:,.4f}'.format(item['item_mxn'])"/>
                                                    </td>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                        <t t-esc="'{0:,.2f}'.format(item['item_import'])"/>
                                                    </td>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                        <t t-esc="'{0:,.4f}'.format(item['costo_kg_masa_formula'])"/>
                                                    </td>
                                                    <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                        <t t-esc="'{0:,.2f}'.format(item['pct_costo'])"/>%
                                                    </td>
                                                </tr>
                                            </t>
                                            <!-- Subtotal del módulo -->
                                            <tr>
                                                <td class="table-secondary" colspan="7" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                    <strong>Costo por Kg. de masa (<t t-esc="bloque['nombre']"/>):</strong>
                                                </td>
                                                <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                                <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                    <strong t-esc="'{0:,.2f}'.format(bloque['total_bloque'])"/>
                                                </td>
                                                <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                    <strong t-esc="'{0:,.4f}'.format(bloque['costo_kg_bloque'])"/>
                                                </td>
                                                <td class="table-secondary" style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                    <t t-esc="'{0:,.2f}'.format(bloque['pct_costo_bloque'])"/>%
                                                </td>
                                            </tr>
                                        </t>

                                        <!-- ── Merma asociada a este módulo (si existe) ── -->
                                        <t t-if="bloque['merma']">
                                            <tr>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px">
                                                    <strong>MERMA <t t-esc="bloque['merma']['nombre']"/> <t t-esc="'{0:,.2f}'.format(bloque['merma']['pct'])"/>%</strong>
                                                </td>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                    <t t-esc="'{0:,.4f}'.format(bloque['merma']['masa_despues'])"/>
                                                </td>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px">KG</td>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                    <t t-esc="'{0:,.2f}'.format(bloque['merma']['total_acumulado'])"/>
                                                </td>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                    <t t-esc="'{0:,.4f}'.format(bloque['merma']['costo_kg_post_merma'])"/>
                                                </td>
                                                <td style="border-style: solid;border-width: 1px;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                                    <t t-esc="'{0:,.2f}'.format(bloque['merma']['pct_costo'])"/>%
                                                </td>
                                            </tr>
                                        </t>
                                    </t>

                                    <!-- ── COSTO FINAL ── -->
                                    <tr>
                                        <td class="table-secondary" colspan="7" style="border-style: solid;border-width: 1px;border-top: 2px solid #000000;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                            <strong>Costo final por Kg. de producto:</strong>
                                        </td>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;border-top: 2px solid #000000;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px"/>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;border-top: 2px solid #000000;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                            <strong t-esc="'{0:,.2f}'.format(combined_total)"/>
                                        </td>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;border-top: 2px solid #000000;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                            <strong t-esc="'{0:,.4f}'.format(costo_final_kg)"/>
                                        </td>
                                        <td class="table-secondary" style="border-style: solid;border-width: 1px;border-top: 2px solid #000000;padding-bottom:0px;padding-top:0px;font-size:11px;vertical-align:middle; padding:2px" align="right">
                                            <strong>100.00%</strong>
                                        </td>
