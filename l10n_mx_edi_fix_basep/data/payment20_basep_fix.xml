<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fix CRPER654: BaseP — ya instalado y funcionando, mantener igual -->
    <template id="payment20_basep_fix" inherit_id="l10n_mx_edi.payment20">
        <xpath expr="//*[@t-att-BaseP=&quot;format_float(tax_values['base'], precision=6)&quot;]" position="attributes">
            <attribute name="t-att-BaseP">format_float(round(tax_values['base'], 2), precision=2)</attribute>
        </xpath>
    </template>

    <!-- Fix CRPER659 y siguientes: ImporteP, BaseDR, ImporteDR -->
    <template id="payment20_imports_fix" inherit_id="l10n_mx_edi.payment20">
        <!-- ImporteP: aplica a RetencionP (línea 117) y TrasladoP (línea 126) -->
        <xpath expr="//*[@t-att-ImporteP=&quot;format_float(tax_values['importe'], precision=6)&quot;]" position="attributes">
            <attribute name="t-att-ImporteP">format_float(round(tax_values['importe'], 2), precision=2)</attribute>
        </xpath>
        <!-- BaseDR: dos bloques en el template (líneas 91 y 102) -->
        <xpath expr="//*[@t-att-BaseDR=&quot;invoice_values['format_float'](tax_values['base'], precision=6)&quot;]" position="attributes">
            <attribute name="t-att-BaseDR">invoice_values['format_float'](round(tax_values['base'], 2), precision=2)</attribute>
        </xpath>
        <!-- ImporteDR: dos bloques en el template (líneas 92 y 103) -->
        <xpath expr="//*[@t-att-ImporteDR=&quot;invoice_values['format_float'](tax_values['importe'], precision=6)&quot;]" position="attributes">
            <attribute name="t-att-ImporteDR">invoice_values['format_float'](round(tax_values['importe'], 2), precision=2)</attribute>
        </xpath>
    </template>
</odoo>