<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BaseDR e ImporteDR en pago20:TrasladoDR siguen con precision=6 en enterprise.
         BaseP, ImporteP y Totales ya fueron corregidos por Odoo.
         El fix de CRP20268 (BaseP = Σ BaseDR) se maneja en models/account_move.py -->
    <template id="payment20_imports_fix" inherit_id="l10n_mx_edi.payment20">
        <xpath expr="//*[local-name()='TrasladoDR']" position="attributes">
            <attribute name="t-att-BaseDR">invoice_values['format_float'](round(tax_values['base'], 2), precision=2)</attribute>
            <attribute name="t-att-ImporteDR">invoice_values['format_float'](round(tax_values['importe'], 2), precision=2)</attribute>
        </xpath>
    </template>
</odoo>